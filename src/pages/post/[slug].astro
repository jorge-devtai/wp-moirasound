---
import { allPagesSlug } from "@libs/wp"
// corregir  está función para que retorne un array de slugs
const slug = Astro.params.slug
if ( !slug ) return Astro.redirect("/404")

export async function getStaticPaths () {
    const slugs = await allPagesSlug(slug) 
   Array.isArray(slugs)
  ? slugs.map((slug: any) => ({ params: { slug } }))
  : []
}
