---
import { getAllSlugsPages, getInfoPage } from "@libs/apiPages.ts"
import PageLayout from "@layouts/PageLayout.astro"

export async function getStaticPaths() {
  const slugs = await getAllSlugsPages()
  return slugs.map((slug: string) => ({ params: { slug } }))
}

const { slug } = Astro.params
const pageData = await getInfoPage(slug)
if (!pageData) return Astro.redirect('/404')

const { pageTitle, heroTitle, heroDescription, heroButton } = pageData

console.log(pageData)



---
<PageLayout
  pageSlug={slug}
  pageTitle={pageTitle}
  heroTitle={heroTitle}
  heroDescription={heroDescription}
  heroButton={heroButton}
>

  {slug === 'mision' && (
    <section >
      <h2>Mision Section</h2>
    </section>
  )}


</PageLayout>
