---
import { allPagesSlug } from "@libs/wp"
import BaseLayout from "@layouts/BaseLayout.astro"

const slug = Astro.params.slug
if (!slug) return Astro.redirect('/')

export async function getStaticPaths() {
  const slugs = await allPagesSlug()
  return slugs.map((slug: string) => ({ params: { slug } }))
}

---

<BaseLayout pageTitle= { Astro.params.slug }>
    <h1>Página dinámica para: {Astro.params.slug}</h1>
</BaseLayout>