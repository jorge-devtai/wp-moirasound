---
import LogoMoiraSound from '@assets/logoMoiraSound.svg'
import { getNavMenu } from '@libs/wp'

const menuItems = await getNavMenu();
---
<header>
    <figure>
        <img src={LogoMoiraSound.src} alt="Logotipo MoiraSound" loading="lazy" width="172" height="80"/>
    </figure>
    <nav>
        <menu>
          {menuItems.map((item:any) => (
            <li><a href={item.url}>{item.title}</a></li>
          ))}
        </menu>
    </nav>
</header>


<style>
    header {
        display: flex;
        background-color: var(--color-moira-contrast);
        justify-content: space-between;
        padding-inline: 5rem;
        padding-block: 1.5rem;

        > figure {
            display: flex;
            align-items: center;
            justify-content: center;
            inline-size: 100px;

            > img {
                min-inline-size: 100%;
                block-size: auto;
                object-fit: cover;
            }
        }

        & nav {
            display: grid;
            place-content: center;

            & menu {
                display: flex;
                font-family: 'Geologica';
                list-style-type: none;
                gap: 1rem;
                 

                & a {
                color: var(--color-moira-base);
                }
            }

           
        }
        
    }
</style>