---
interface ArtistProps {
  artistName?: string;
  artistDescription?: string;
  artistTitle?: string;
  featuredImage?: string;
  styleName?: string;
  country?: string;
}

const {artistTitle, artistName, artistDescription, featuredImage, styleName, country }: ArtistProps = Astro.props 
---

<label style=`--_img: url("${featuredImage}")`>          
    <input type="radio" name="images" value={artistTitle}>
    <h3>{artistName}</h3>
    <p>{artistDescription}</p>
    <div>
      <span class="tag">{styleName}</span>
      <span class="tag">{country}</span>
    </div>
</label>



<style>
  label {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: end;
    gap: 1rem;
    padding: 2rem;
    color: var( --color-moira-base);

    > p {
      display: none;
    }

    > div {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }
  }

  .tag {
         
    &:nth-child(odd) {
      background-color: var(--_tag1);
    }

    &:nth-child(even) {
      background-color: var(--_tag2);
    }
  }

  
</style>