---
import Button from "@components/Button.astro";
import CardNews from "@components/CardNews.astro";
import { getNewsInfo } from "@libs/apiPosts.ts";
import { getInfoPage } from "@libs/apiPages.ts";

const news = await getNewsInfo({ perPage: 3 });

const { pageSlug, newsTitle, newsButton } = Astro.props;

const { newsBlock } = await getInfoPage(pageSlug);

const byId = new Map(news.map((newItem) => [newItem.newsId, newItem]));
console.log("Esto los ids de bloque de NOTICIAS Y ENTREVISTAS" ,byId);

const newsToShow = newsBlock
   .map((id: number) => byId.get(id))
   .filter(Boolean);


---

<section>
    <div>
        <div
            class="grid layout-container"
            max-column-count="2"
            grid-gap="32px"
            min-container-grid="280px"
        >
            <h2>{newsTitle}</h2>

            {newsButton && (
                    <Button
                        buttonText={newsButton.buttonText}
                        href={newsButton.href}
                        target={newsButton.target}
                        variant="secondary"
                        size="large"
                    />
            )}
        </div>

        <div layout-container>
            {
                newsToShow.map((post: any) => (
                    <CardNews
                        titlePost={post.newsTitle}
                        excerptPost={post.newsExcerpt}
                        datePost={post.newsDate}
                        featuredImagePost={post.featuredImageNews}
                        postType={post.newsCategories}
                    />
                ))
            }
        </div>
    </div>
</section>

<style>
    section {
        color: var(--color-moira-contrast);
        padding-inline: var(--space-inline-layout);
        padding-block: var(--space-block-laytout);

        > div {
            display: grid;
            max-inline-size: 1512px;
            margin-inline: auto;
            gap: 2rem;

            div:is(div > .btn-group) {
                justify-content: end;
            }

            @media (width < 661px) {
                div:is(div > .btn-group) {
                    justify-content: start;
                }
            }
        }
    }
</style>
