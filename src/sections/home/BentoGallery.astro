---
import { getBentoImages } from "@libs/wp";

const imageUrls = await getBentoImages("home-bento");
---

<section>
    <div>
        <div
            class="grid layout-container"
            max-column-count="1"
            grid-gap="32px"
            min-container-grid="280px"
        >
            <h2>Galería Multimedia</h2>
            <p>
                Lorem ipsum dolor sit amet, consectetur adipiscing elit.
                Curabitur suscipit eu urna eu vehicula. Aliquam interdum lacinia
                leo, a posuere dui ornare et. Curabitur quis libero magna. Fusce
                eu lectus erat.
            </p>
        </div>

        <div>
            <div class="bento">
                {
                    imageUrls.map((url) => (
                        <div class="card">
                            <img
                                src={url}
                                alt="imagen de galería"
                                loading="lazy"
                            />
                        </div>
                    ))
                }
            </div>
        </div>
    </div>
</section>

<style>
    section {
        color: var(--color-moira-base);
        background-color: var(--color-moira-contrast);
        padding-inline: var(--space-inline-layout);
        padding-block: var(--space-block-laytout);

        > div {
            display: grid;
            max-inline-size: 1512px;
            margin-inline: auto;
            gap: 2rem;

        }
    }

    .layout-container {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .bento {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        grid-template-rows: repeat(5, 1fr);
        gap: 1rem;
        width: 100%;
        margin: 2rem auto;
        aspect-ratio: 5 / 4; 
    }

    /* 2. Cada tarjeta con imagen */
    .card {
        display: flex;
        overflow: hidden;
        border-radius: 1rem;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
        min-block-size: 15rem;
    }

    .card img {
        min-inline-size: 100%;
        flex: 1;
        object-fit: cover;
    
    }

    /* 3. Posición y span de cada tarjeta */
    .card:nth-child(1) {
        grid-area: 1 / 1 / span 1 / span 2;
    }
    .card:nth-child(2) {
        grid-area: 1 / 3 / span 1 / span 2;
    }
    .card:nth-child(3) {
        grid-area: 1 / 5 / span 2 / span 1;
    }
    .card:nth-child(4) {
        grid-area: 2 / 1 / span 3 / span 1;
    }
    .card:nth-child(5) {
        grid-area: 2 / 2 / span 2 / span 3;
    }
    .card:nth-child(6) {
        grid-area: 3 / 5 / span 2 / span 1;
    }
    .card:nth-child(7) {
        grid-area: 4 / 2 / span 1 / span 3;
    }
</style>
