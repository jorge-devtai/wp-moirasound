---
import Button from "@components/Button.astro";
import CardEvent from "@components/CardEvent.astro";
import { getEventInfo } from "@libs/apiEvents.ts";
import { getInfoPage } from "@libs/apiPages";

const events = await getEventInfo({ perPage: 3});

const { pageSlug, eventsTitle, eventsSubtitle, eventButton } = Astro.props;

const { eventsBlock } = await getInfoPage(pageSlug);

const byId = new Map(events.map((eventItem) => [eventItem.eventId, eventItem]));
console.log("Esto los ids de bloque de eventos" ,byId);

const eventsToShow = eventsBlock
   .map((id: number) => byId.get(id))
   .filter(Boolean);


---

<artice>
    <section>
        <header
            class="grid"
            max-column-count="3"
            grid-gap="32px"
            min-container-grid="280px"
        >
            <h2>{eventsTitle}</h2>
            <h3>{eventsSubtitle}</h3>
            <span class="btn-wrap">          
                {eventButton && (
                    <Button
                        buttonText={eventButton.buttonText}
                        href={eventButton.href}
                        target={eventButton.target}
                        variant="primary"
                        size="large"
                    />
                )}
            </span>
        </header>
        <div
            class="grid"
            max-column-count="3"
            grid-gap="32px"
            min-container-grid="200px"
        >
            {
                eventsToShow.map((event:any) => (
                    <CardEvent
                        eventName={event.eventAcf.eventName}
                        eventDate={event.eventAcf.eventDate}
                        eventAddress={event.eventAcf.eventAddress}
                        eventTime={event.eventAcf.eventTime}
                        artistName={event.artistName.join(", ")}
                        featuredImageEvent={event.featuredImageEvent}
                        eventType={event.eventTypes}
                    />
                ))
            }
        </div>
    </section>
</artice>

<style>
    section {
        color: var(--color-moira-contrast);
        padding-inline: var(--space-inline-layout);
        padding-block: var(--space-block-laytout);

        > header {
            display: grid;
            max-inline-size: 1512px;
            margin-inline: auto;
            gap: 2rem;

            > .btn-wrap {
                display: flex;
                align-items: start;
                justify-content: end;
            }

            @media (width < 1110px) {
                header > .btn-wrap {
                    justify-content: start;
                }
            }
        }

        > div {
            max-inline-size: 1512px;
            margin-inline: auto;
            margin-block-start: 4rem;
        }
    }
</style>
