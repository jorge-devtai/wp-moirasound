---
import Button from "@components/Button.astro";
import ImageMision from "@assets/images/image-moirasound.webp";

---

<section>
    <div
        class="layout-container grid"
        max-column-count="2"
        grid-gap="2rem"
        min-container-grid="200px"
    >
        <div>
            <h2>Titulo</h2>
            <p>
                Moira Sound difunde y potencia el talento emergente. Conectamos
                artistas con oportunidades únicas y audiencias globales.
            </p>
            <Button buttonText='Conoce nuestra misión' variant="secondary", size="large"/>
        </div>
        <figure>
            <img src={ImageMision.src} alt="imagen de misión" />
        </figure>
    </div>
</section>

<style>
    section {
        color: var(--color-moira-contrast);
        padding-inline: var(--space-inline-layout);
        padding-block: var(--space-block-laytout);

        & .layout-container {
            max-inline-size: 1512px;
            margin-inline: auto;

            > div {
                display: flex;
                flex-direction: column;
                gap: 2rem;

                > :where(h2) {
                    text-transform: uppercase;
                }

                > :is(.btn-group) {
                    justify-content: start;
                }
            }
        }
    }

    figure {
        border-radius: 65px;
        overflow: hidden;
    }
</style>
