---
import Button from "@components/Button.astro";
import ImageMision from "@assets/images/image-moirasound.webp";

const { featureTitle, featureDescription, featureButton} = Astro.props

---

<section>
    <div
        class="layout-container grid"
        max-column-count="2"
        grid-gap="2rem"
        min-container-grid="200px"
    >
        <div>
            <h2>{featureTitle}</h2>
            <p>{featureDescription}</p>
              {featureButton && (
                <Button
                    buttonText={featureButton.buttonText}
                    href={featureButton.href}
                    target={featureButton.target}
                    variant="secondary"
                    size="large"
                />
            )}
        </div>
        <figure>
            <img src={ImageMision.src} alt="imagen de misión" />
        </figure>
    </div>
</section>

<style>
    section {
        color: var(--color-moira-contrast);
        padding-inline: var(--space-inline-layout);
        padding-block: var(--space-block-laytout);

        & .layout-container {
            max-inline-size: 1512px;
            margin-inline: auto;

            > div {
                display: flex;
                flex-direction: column;
                gap: 2rem;

                > :where(h2) {
                    text-transform: uppercase;
                }

                > :is(.btn-group) {
                    justify-content: start;
                }
            }
        }
    }

    figure {
        border-radius: 65px;
        overflow: hidden;
    }
</style>
